#* Build petshop repository

#* Variables for ASM source files
asmdir      := $(gitdir)/ASM
asmfiles    := ${sh cd $(asmdir); +
                    find * -prune -type f -name "*.asm" 2>&1 | +
                    grep -v EDC5129I}
asmmems     := ${stripext $(asmfiles)}
asmlib      := $(hlq).ASM
asmtgts     := ${addpdsname $(asmlib),$(asmmems)}

#* Variables for BMSMAP source files
bmsdir      := $(gitdir)/BMSMAP
bmsfiles    := ${sh cd $(bmsdir); +
                    find * -prune -type f -name "*.asm" 2>&1 | +
                    grep -v EDC5129I}
bmsmems     := ${stripext $(bmsfiles)}
bmslib      := $(hlq).BMSMAP
bmstgts     := ${addpdsname $(bmslib),$(bmsmems)}

#* Variables for COPY source files
cpydir      := $(gitdir)/COPY
cpyfiles    := ${sh cd $(cpydir); +
                    find * -prune -type f -name "*.cpy" 2>&1 | +
                    grep -v EDC5129I}
cpymems     := ${stripext $(cpyfiles)}
cpylib      := $(hlq).COPY
cpytgts     := ${addpdsname $(cpylib),$(cpymems)}

#* Variables for COBOL source files
cbldir      := $(gitdir)/COBOL
cblfiles    := ${sh cd $(cbldir); +
                    find * -prune -type f -name "*.cbl" 2>&1 | +
                    grep -v EDC5129I}
cbldb2files := ${sh cd $(cbldir); +
                    find * -prune -type f -name "PETM*.cbl" 2>&1 | +
                    grep -v EDC5129I}
cblcicsfiles := ${sh cd $(cbldir); +
                    find * -prune -type f -name "PETC*.cbl" 2>&1 | +
                    grep -v EDC5129I}
cblmems     := ${stripext $(cblfiles)}
cbldb2mems  := ${stripext $(cbldb2files)}
cblcicsmems := ${stripext $(cblcicsfiles)}
cbllib      := $(hlq).COBOL
cbltgts     := ${addpdsname $(cbllib),$(cblmems)}

#* Variables for LKED source files
lkeddir     := $(gitdir)/LKED
lkedfiles   := ${sh cd $(lkeddir); +
                    find * -prune -type f -name "*.lked" 2>&1 | +
                    grep -v EDC5129I}
lkedmems    := ${stripext $(lkedfiles)}
lkedlib     := $(hlq).LKED
lkedtgts    := ${addpdsname $(lkedlib),$(lkedmems)}

#* Variables for OPTFILE source files
optdir      := $(gitdir)/OPTFILE
optfiles    := ${sh cd $(optdir); +
                    find * -prune -type f -name "*.opt" 2>&1 | +
                    grep -v EDC5129I}
optmems     := ${stripext $(optfiles)}
optlib      := $(hlq).OPTFILE
opttgts     := ${addpdsname $(optlib),$(optmems)}

#* Variables for JCL source files
jcldir      := $(gitdir)/JCL
jclfiles    := ${sh cd $(jcldir); +
                    find * -prune -type f -name "*.jcl" 2>&1 |+
                    grep -v EDC5129I}
jclmems     := ${stripext $(jclfiles)}
jcllib      := $(hlq).JCL
jcltgts     := ${addpdsname $(jcllib),$(jclmems)}

#* Variables for COBOL compile, ASM assembly and link-edit
tmpasmlib   := ${function TEMPPDS}
asmlstlib   := $(hlq).ASM.LISTING
adatalib    := $(hlq).SYSADATA
langxlib    := $(hlq).EQALANGX
cbllstlib   := $(hlq).COBOL.LISTING
objlib      := $(hlq).OBJECT
objasmtgts  := ${addpdsname $(objlib),$(asmmems)}
objbmstgts  := ${addpdsname $(objlib),$(bmsmems)}
objcbldb2tgts := ${addpdsname $(objlib),$(cbldb2mems)}
objcblcicstgts := ${addpdsname $(objlib),$(cblcicsmems)}
dbrmlib     := $(hlq).DBRM
lkedlstlib  := $(hlq).LKED.LISTING
loadlib     := $(hlq).LOAD
loadtgts    := ${addpdsname $(loadlib),$(bmsmems)}+
               ${addpdsname $(loadlib),$(asmmems)}+
               ${addpdsname $(loadlib),$(cbldb2mems)}+
               ${addpdsname $(loadlib),$(cblcicsmems)}
syslib_asm  := SYS1.MACLIB CEE.SCEEMAC HLA.SASMMAC2+
               $(cicshlq).CICS.SDFHMAC
syslib_cbl  := CEE.SCEESAMP $(cicshlq).CICS.SDFHCOB $(cpylib)
syslib_lked := CEE.SCEELKED $(cicshlq).CICS.SDFHLOAD $(db2hlq).SDSNLOAD+
               $(objlib)

#* Group of data set names with specific characteristics
recfmFB80   := $(asmlib) $(bmslib) $(cpylib) $(cbllib) $(lkedlib)+
               $(optlib) $(objlib) $(dbrmlib) $(jcllib)
recfmFBA133 := $(asmlstlib) $(cbllstlib)
recfmVBM133 := $(lkedlstlib)
recfmVB1562 := $(langxlib)
recfmVB32K  := $(adatalib)
recfmU      := $(loadlib)

datasets    := $(recfmFB80) $(recfmFBA133) $(recfmVBM133)+
               $(recfmVB1562) $(recfmVB32K) $(recfmU)

#* Phony target that builds all
.PHONY BUILD_ALL
BUILD_ALL : $(datasets) $(asmtgts) $(bmstgts) $(cpytgts) $(cbltgts)+
            $(lkedtgts) $(opttgts) $(jcltgts) $(loadtgts)

#* Phony target just to get USS copied to PDSE's
.PHONY SETUP
SETUP : $(datasets)

#* Write ASM sources from USS to PDS
$(asmtgts) : $(asmdir)/$%.asm
- CALL OGETU '$(asmdir)/$%.asm' '$@' ISO88591

#* Write BMSMAP sources from USS to PDS
$(bmstgts) : $(bmsdir)/$%.asm
- CALL OGETU '$(bmsdir)/$%.asm' '$@' ISO88591

#* Write COPY sources from USS to PDS
$(cpytgts) : $(cpydir)/$%.cpy
- CALL OGETU '$(cpydir)/$%.cpy' '$@' ISO88591

#* Write COBOL sources from USS to PDS
$(cbltgts) : $(cbldir)/$%.cbl
- CALL OGETU '$(cbldir)/$%.cbl' '$@' ISO88591

#* Write LKED sources from USS to PDS
$(lkedtgts) : $(lkeddir)/$%.lked
- CALL OGETU '$(lkeddir)/$%.lked' '$@' ISO88591

#* Write OPTFILE sources from USS to PDS
$(opttgts) : $(optdir)/$%.opt
- CALL OGETU '$(optdir)/$%.opt' '$@' ISO88591

#* Write JCL sources from USS to PDS
$(jcltgts) : $(jcldir)/$%.jcl
- CALL OGETU '$(jcldir)/$%.jcl' '$@' ISO88591

#* Assemble ASM source
$(objasmtgts) : $(asmlib)($%)
- CALL DFHEAP SYSIN($(asmlib)($%)) SYSPUNCH($(tmpasmlib)($%))+
-             PARM(NOPROLOG,NOEPILOG)
- CALL ASMA SYSIN($(tmpasmlib)($%)) SYSLIN($(objlib)($%))+
-           SYSLIB($(syslib_asm)) SYSADATA($(adatalib)($%))+
-           SYSPRINT($(asmlstlib)($%)) PRINTSUCCESS(NO)+
-           PARM(ADATA,GOFF,LIST(133),DBCS,CODEPAGE(LOCAL))
- CALL EQALANGX SYSADATA($(adatalib)($%)) IDILANGX($(langxlib)($%))+
-               PARM(ASM ERROR)
- CALL TOUCHMEM DATASET($(objlib)($%))
- CALL TOUCHMEM DATASET($(asmlstlib)($%))

#* Assemble BMSMAPs twice if needed
$(objbmstgts) : $(bmslib)($%)
- CALL ASMA SYSIN($(bmslib)($%)) SYSLIN($(cpylib)($%))+
-           SYSLIB($(syslib_asm)) PARM(NODECK,OBJECT,SYSPARM(DSECT))+
-           PRINTSUCCESS(NO)
- CALL TOUCHMEM DATASET($(cpylib)($%))
- CALL ASMA SYSIN($(bmslib)($%)) SYSLIN($(objlib)($%))+
-           SYSLIB($(syslib_asm)) PARM(NODECK,OBJECT,SYSPARM(MAP))+
-           SYSPRINT($(asmlstlib)($%)) PRINTSUCCESS(NO)
- CALL TOUCHMEM DATASET($(objlib)($%))
- SH cd $(gitdir)/COPY.NOCOMMIT; +
-    cp "//'$(cpylib)($%)'" /tmp/$%.cpy.037; +
-    iconv -f 037 -t 819 -T /tmp/$%.cpy.037 > $%.cpy; +
-    rm /tmp/$%.cpy.037

#* Compile COBOL DB2 source
$(objcbldb2tgts) : $(cbllib)($%)
- CALL COBOL6 SYSIN($(cbllib)($%)) SYSLIN($(objlib)($%))+
-             SYSLIB($(syslib_cbl)) SYSPRINT($(cbllstlib)($%))+
-             SYSOPTF($(optlib)(DB2)) DBRMLIB($(dbrmlib)($%))+
-             PRINTSUCCESS(NO)
- CALL TOUCHMEM DATASET($(objlib)($%))
- CALL TOUCHMEM DATASET($(dbrmlib)($%))
- CALL TOUCHMEM DATASET($(cbllstlib)($%))

#* Compile COBOL CICS source
$(objcblcicstgts) : $(cbllib)($%)
- CALL COBOL6 SYSIN($(cbllib)($%)) SYSLIN($(objlib)($%))+
-             SYSLIB($(syslib_cbl)) SYSPRINT($(cbllstlib)($%))+
-             SYSOPTF($(optlib)(CICS)) PRINTSUCCESS(NO)
- CALL TOUCHMEM DATASET($(objlib)($%))
- CALL TOUCHMEM DATASET($(cbllstlib)($%))

#* Link-edit COBOL/ASM object if needed
$(loadtgts) : $(objlib)($%) $(lkedlib)($%)
- CALL LKED SYSLIN($(lkedlib)($%)) SYSLMOD($(loadlib)($%))+
-           SYSLIB($(syslib_lked)) SYSPRINT($(lkedlstlib)($%))+
-           PARM(LIST,XREF,RENT,REUS) PRINTSUCCESS(NO)
- CALL TOUCHMEM DATASET($(lkedlstlib)($%))

#* Allocate LRECL=80 RECFM=FB data sets
$(recfmFB80) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(F,B) LRECL(80)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=133 RECFM=FBA data sets
$(recfmFBA133) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(F,B,A) LRECL(133)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=133 RECFM=VBM data sets
$(recfmVBM133) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(V,B,M) LRECL(133)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=1562 RECFM=VB data sets
$(recfmVB1562) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(V,B) LRECL(1562)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=32756 RECFM=VB data sets
$(recfmVB32K) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(V,B) LRECL(32756)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=0 RECFM=U data sets
$(recfmU) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(U) LRECL(0)+
-             BLKSIZE(32760) CYLINDERS SPACE(1,1) DSORG(PO)+
-             DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')
